# Copy this file to .env and fill in your values.
# For Gmail, use an App Password (not your normal Gmail password).

# Which django_site row this deployment is (django.contrib.sites / Google login).
# Leave unset locally (defaults to 2 = 127.0.0.1:8000). On Render, set this to 3,
# the row already created for the live onrender.com domain -- otherwise Google
# login and any allauth account email/page will use the wrong site.
SITE_ID=

# PostgreSQL (Supabase): Project Settings → Database.
# If db.<ref>.supabase.co fails (IPv6-only), use the pooler "Session mode" URI:
# host aws-*-*.pooler.supabase.com, port 5432, user postgres.<project_ref>.
# Transaction pooler (6543) often misbehaves with Django migration checks.
DATABASE_NAME=postgres
DATABASE_USER=postgres.your_project_ref
DATABASE_PASSWORD=your_database_password
DATABASE_HOST=aws-0-your-region.pooler.supabase.com
DATABASE_PORT=5432

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=yourgmail@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_gmail_app_password
DEFAULT_FROM_EMAIL=Arabela <yourgmail@gmail.com>

# Cloudinary (cloudinary.com free tier): persistent storage for gown photos,
# payment proofs, and profile pictures. Required on Render -- its local disk is
# wiped on every restart. Leave blank locally to just use the local media/
# folder instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# PayMongo (online payments with GCash, Maya and QR Ph). Leave PAYMONGO_SECRET_KEY blank to keep the older GCash-screenshot checkout.
# Keys: PayMongo dashboard > Developers > API Keys. Use the TEST secret key (sk_test_...) while testing: no real money moves.
# NEVER put a secret key in a web page, a chat or git. On Render, set these in the service's Environment tab.
PAYMONGO_SECRET_KEY=
# Dashboard > Developers > Webhooks > Add endpoint (https://<your-site>/paymongo/webhook/): it shows this secret (whsk_...).
PAYMONGO_WEBHOOK_SECRET=
# The methods PayMongo's page offers (PayMongo's own names). Default: gcash,paymaya,qrph
PAYMONGO_METHODS=gcash,paymaya,qrph

# Xendit (online payments with GCash, Maya and QR Ph; it replaced PayMongo). Leave XENDIT_SECRET_KEY blank to keep the older checkout.
# Dashboard (Test Mode) > Settings > Developers > API Keys > Generate secret key, with "Money-in products" set to WRITE. A test key
# (xnd_development_...) moves no real money: Xendit's page has a "Proceed to Pay" button. A live key (xnd_production_...) is refused on a laptop copy.
XENDIT_SECRET_KEY=
# Settings > Developers > Callbacks: set the URL https://<your-site>/xendit/webhook/ and copy the "webhook verification token" here.
XENDIT_WEBHOOK_TOKEN=
# xendit, paymongo, or blank (= Xendit while its key is set, else PayMongo).
PAYMENT_PROVIDER=
# The ways to pay Xendit's page offers (Xendit's own names). Default: GCASH,PAYMAYA,QRPH
XENDIT_CHANNELS=GCASH,PAYMAYA,QRPH
