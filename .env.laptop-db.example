# The laptop's own database (a separate free Supabase project), so local clicking never changes the live shop.
# Copy this file to .env.laptop-db (never committed) and fill it in from that project's  Connect -> Session pooler  page.
# Delete .env.laptop-db to go back to the live database. `python live.py <command>` reaches live on purpose.
# Only these five lines are read; everything else still comes from .env.
DATABASE_NAME=postgres
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=5432
